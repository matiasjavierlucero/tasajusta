# ─── Postgres ────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=                
POSTGRES_DB=t

# ─── MinIO (S3-compatible local) ─────────────────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ─── App ─────────────────────────────────────────────────────
# DATABASE_URL (dentro de la red Docker — "postgres" es el hostname del servicio)
DATABASE_URL=

# MinIO endpoint y bucket de trabajo
MINIO_ENDPOINT=
MINIO_BUCKET=

# Groq IA
GROQ_API_KEY=

# ─── Langfuse (observabilidad del agente) ─────────────────────
# Crear proyecto en https://cloud.langfuse.com y copiar las keys de Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com